# Web
VITE_API_BASE=

# API secrets (wrangler secret put ...)
HANDLE_PEPPER=replace-me
KEK_MASTER=replace-me-32+chars

# Partner SSO feature flags (wrangler.toml [vars])
ENDAO_SSO_ENABLED=false
WEREAD_SSO_ENABLED=false

# TURN / Cloudflare Calls (ephemeral HMAC-SHA1 credentials; TTL 300s)
# For production prefer Cloudflare Calls or an external TURN provider.
TURN_SECRET=dev-turn-secret
TURN_URIS=["stun:stun.cloudflare.com:3478"]
