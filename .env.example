# ── Web (Vite; baked in at build time) ──────────────────────────────────────
VITE_API_BASE=

# ── API secrets (wrangler secret put … — never commit real values) ──────────
# HMAC pepper for handle/email hashing
HANDLE_PEPPER=replace-me
# AES master key for field-level encryption (≥32 chars)
KEK_MASTER=replace-me-32+chars
# Ephemeral TURN HMAC secret (coturn REST / Cloudflare Calls style)
TURN_SECRET=dev-turn-secret

# ── API non-secret vars (wrangler.toml [vars] or Pages) ─────────────────────
APP_NAME=LogosHome
ENVIRONMENT=development
# Partner SSO feature flags
ENDAO_SSO_ENABLED=false
WEREAD_SSO_ENABLED=false
# JSON array of TURN/STUN URIs
TURN_URIS=["stun:stun.cloudflare.com:3478"]

# ── Cloudflare resource IDs (wrangler.production.toml placeholders) ─────────
# CLOUDFLARE_ACCOUNT_ID=
# D1_DATABASE_ID=
# R2_BUCKET_NAME=logoshome-media

# ── Mobile / EAS (optional) ─────────────────────────────────────────────────
# EXPO_PUBLIC_API_BASE=
# EAS_PROJECT_ID=
