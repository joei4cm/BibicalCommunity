{
  "name": "logoshome-desktop",
  "version": "0.1.14",
  "private": true,
  "description": "Electron shell packaging the LogosHome web build for Linux / macOS / Windows",
  "author": "LogosHome <dev@logoshome.app>",
  "homepage": "https://github.com/joei4cm/BibicalCommunity",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "app.logoshome.desktop",
    "productName": "LogosHome",
    "executableName": "LogosHome",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "executableName": "LogosHome",
      "maintainer": "LogosHome <dev@logoshome.app>",
      "vendor": "LogosHome"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "LogosHome"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  }
}
